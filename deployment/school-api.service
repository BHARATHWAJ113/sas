[Unit]
Description=St Antony's School API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=school-api
WorkingDirectory=/var/www/st-antonys/server
EnvironmentFile=/var/www/st-antonys/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/st-antonys/uploads
UMask=0077

[Install]
WantedBy=multi-user.target
