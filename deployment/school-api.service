[Unit]
Description=St Antony's School API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=school-api
Group=school-web
SupplementaryGroups=school-private
WorkingDirectory=/var/www/stantonysneyveli.in/live/server
EnvironmentFile=/var/www/stantonysneyveli.in/shared/server.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/st-antonys/uploads
UMask=0027

[Install]
WantedBy=multi-user.target
