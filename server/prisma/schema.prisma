generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}
datasource db {
  provider = "mysql"
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum AnnouncementKind {
  ANNOUNCEMENT
  NOTICE
  NEWS
}
enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}
enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  PARTIAL
  UNKNOWN
}
enum ConsentChoice {
  ACCEPTED
  REJECTED
}
model Role {
  id    String @id @default(cuid()) @db.VarChar(191)
  name  String @unique @db.VarChar(50)
  users User[]
  @@map("roles")
}
model User {
  id           String @id @default(cuid()) @db.VarChar(191)
  email        String @unique @db.VarChar(191)
  name         String @db.VarChar(120)
  passwordHash String @db.VarChar(255)
  active       Boolean @default(true)
  roleId       String @db.VarChar(191)
  role         Role @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  emails       EmailMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("users")
}
model Session {
  id        String @id @db.VarChar(64)
  userId    String @db.VarChar(191)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@map("sessions")
}
model Page {
  id             String @id @default(cuid()) @db.VarChar(191)
  slug           String @unique @db.VarChar(160)
  title          String @db.VarChar(255)
  titleTa        String @db.VarChar(255)
  summary        String @db.Text
  summaryTa      String @db.Text
  body           String @db.LongText
  bodyTa         String @db.LongText
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)
  status         ContentStatus @default(DRAFT)
  isDemo         Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status])
  @@map("pages")
}
model Translation {
  id        String @id @default(cuid()) @db.VarChar(191)
  key       String @db.VarChar(191)
  locale    String @db.VarChar(5)
  value     String @db.Text
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime @updatedAt
  @@unique([key, locale])
  @@map("translations")
}
model Announcement {
  id          String @id @default(cuid()) @db.VarChar(191)
  slug        String @unique @db.VarChar(160)
  title       String @db.VarChar(255)
  titleTa     String @db.VarChar(255)
  summary     String @db.Text
  summaryTa   String @db.Text
  body        String @db.LongText
  bodyTa      String @db.LongText
  kind        AnnouncementKind @default(NOTICE)
  status      ContentStatus @default(DRAFT)
  isDemo      Boolean @default(false)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  showPopup   Boolean @default(false)
  priority    Int @default(0)
  announcementType String @default("NOTICE") @db.VarChar(24)
  imageId     String? @db.VarChar(191)
  image       Media? @relation("AnnouncementImage", fields: [imageId], references: [id], onDelete: SetNull)
  footerMessage String? @db.VarChar(500)
  footerMessageTa String? @db.VarChar(500)
  wishes      String? @db.Text
  wishesTa    String? @db.Text
  ctaLabel    String? @db.VarChar(80)
  ctaLabelTa  String? @db.VarChar(120)
  ctaPath     String? @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, kind, publishedAt])
  @@index([showPopup, status, publishedAt, priority])
  @@map("announcements")
}
model Event {
  id             String @id @default(cuid()) @db.VarChar(191)
  slug           String @unique @db.VarChar(160)
  title          String @db.VarChar(255)
  titleTa        String @db.VarChar(255)
  summary        String @db.Text
  summaryTa      String @db.Text
  body           String @db.LongText
  bodyTa         String @db.LongText
  category       String @db.VarChar(80)
  categoryTa     String @db.VarChar(120)
  date           DateTime
  endDate        DateTime?
  location       String @db.VarChar(255)
  locationTa     String @db.VarChar(255)
  cover          String? @db.VarChar(500)
  attachmentId   String? @db.VarChar(191)
  attachment     Media? @relation("EventAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  images         EventImage[]
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)
  status         ContentStatus @default(DRAFT)
  isDemo         Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, date])
  @@map("events")
}
model EventImage {
  id      String @id @default(cuid()) @db.VarChar(191)
  eventId String @db.VarChar(191)
  mediaId String @db.VarChar(191)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order   Int @default(0)
  @@unique([eventId, mediaId])
  @@map("event_images")
}
model Media {
  id          String @id @default(cuid()) @db.VarChar(191)
  filename    String @unique @db.VarChar(255)
  originalName String @db.VarChar(255)
  mimeType    String @db.VarChar(80)
  size        Int
  alt         String @db.VarChar(255)
  altTa       String @db.VarChar(255)
  status      ContentStatus @default(DRAFT)
  honours Honour[]
  staffMembers StaffMember[]
  toppers Topper[]
  description String? @db.Text
  descriptionTa String? @db.Text
  eventDate DateTime?
  hasVariants Boolean @default(false)
  eventImages EventImage[]
  attachments Event[] @relation("EventAttachment")
  galleryMedia GalleryMedia[]
  activities  Activity[]
  announcementImages Announcement[] @relation("AnnouncementImage")
  emailAttachments EmailMessage[] @relation("EmailAttachment")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("media")
}
model ActivityCategory {
  id         String @id @default(cuid()) @db.VarChar(191)
  slug       String @unique @db.VarChar(80)
  title      String @db.VarChar(120)
  titleTa    String @db.VarChar(160)
  icon       String @default("sparkles") @db.VarChar(24)
  sortOrder  Int @default(0)
  status     ContentStatus @default(DRAFT)
  activities Activity[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status, sortOrder])
  @@map("activity_categories")
}
model Activity {
  id         String @id @default(cuid()) @db.VarChar(191)
  slug       String @unique @db.VarChar(160)
  title      String @db.VarChar(255)
  titleTa    String @db.VarChar(255)
  summary    String @db.Text
  summaryTa  String @db.Text
  categoryId String @db.VarChar(191)
  category   ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageId    String? @db.VarChar(191)
  image      Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder  Int @default(0)
  status     ContentStatus @default(DRAFT)
  isDemo     Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([categoryId, status, sortOrder])
  @@index([status, sortOrder])
  @@map("activities")
}
model Gallery {
  id        String @id @default(cuid()) @db.VarChar(191)
  slug      String @unique @db.VarChar(160)
  title     String @db.VarChar(255)
  titleTa   String @db.VarChar(255)
  summary   String @db.Text
  summaryTa String @db.Text
  status    ContentStatus @default(DRAFT)
  isDemo    Boolean @default(false)
  images    GalleryMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("galleries")
}
model GalleryMedia {
  id        String @id @default(cuid()) @db.VarChar(191)
  galleryId String @db.VarChar(191)
  mediaId   String @db.VarChar(191)
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order     Int @default(0)
  @@unique([galleryId, mediaId])
  @@map("gallery_media")
}
model AdmissionEnquiry {
  id          String @id @default(cuid()) @db.VarChar(191)
  parentName  String @db.VarChar(120)
  studentName String @db.VarChar(120)
  email       String @db.VarChar(191)
  phone       String @db.VarChar(20)
  grade       String @db.VarChar(20)
  message     String @db.Text
  locale      String @default("en") @db.VarChar(5)
  consentAt   DateTime @default(now())
  status      EnquiryStatus @default(NEW)
  requestKey  String? @unique @db.VarChar(64)
  payloadHash String? @db.VarChar(64)
  fingerprint String? @unique @db.VarChar(64)
  metadata    Json?
  metadataExpiresAt DateTime?
  emails      EmailMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
  @@index([metadataExpiresAt])
  @@map("admission_enquiries")
}
model EmailMessage {
  id                 String @id @default(cuid()) @db.VarChar(191)
  dedupeKey          String @unique @db.VarChar(64)
  payloadHash        String @db.VarChar(64)
  kind               String @db.VarChar(40)
  to                 String @db.VarChar(191)
  cc                 Json
  bcc                Json?
  attachmentId       String? @db.VarChar(191)
  attachment         Media? @relation("EmailAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  subject            String @db.VarChar(255)
  html               String @db.LongText
  text               String @db.LongText
  replyTo            String? @db.VarChar(191)
  status             EmailStatus @default(PENDING)
  attempts           Int @default(0)
  nextAttemptAt      DateTime @default(now())
  lockedAt           DateTime?
  lockToken          String? @db.VarChar(36)
  lastError          String? @db.VarChar(500)
  messageId          String? @db.VarChar(255)
  accepted           Json?
  rejected           Json?
  sentAt             DateTime?
  expiresAt          DateTime?
  userId             String? @db.VarChar(191)
  user               User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  enquiryId          String? @db.VarChar(191)
  enquiry            AdmissionEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([userId, createdAt])
  @@index([to, createdAt])
  @@map("email_messages")
}
model CookieConsent {
  id        String @id @db.VarChar(64)
  choice    ConsentChoice
  maps      Boolean @default(false)
  analytics Boolean @default(false)
  version   String @db.VarChar(40)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    CookieConsentEvent[]
  @@index([expiresAt])
  @@map("cookie_consents")
}
model CookieConsentEvent {
  id        String @id @default(cuid()) @db.VarChar(191)
  consentId String @db.VarChar(64)
  consent   CookieConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  action    String @db.VarChar(12)
  choice    ConsentChoice
  maps      Boolean @default(false)
  analytics Boolean @default(false)
  version   String @db.VarChar(40)
  createdAt DateTime @default(now())
  @@index([consentId, createdAt])
  @@map("cookie_consent_events")
}
model VisitorRecord {
  id        String @id @default(cuid()) @db.VarChar(191)
  requestKey String @unique @db.VarChar(64)
  path      String @db.VarChar(300)
  consentId String @db.VarChar(64)
  metadata  Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([createdAt])
  @@index([expiresAt])
  @@map("visitor_records")
}
model RateLimitBucket {
  id        String @id @db.VarChar(64)
  count     Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
model AuditLog {
  id        String @id @default(cuid()) @db.VarChar(191)
  userId    String? @db.VarChar(191)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String @db.VarChar(80)
  entity    String @db.VarChar(80)
  entityId  String? @db.VarChar(191)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("audit_logs")
}
model SiteSetting {
  id        String @id @default(cuid()) @db.VarChar(191)
  key       String @unique @db.VarChar(191)
  value     String @db.Text
  public    Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@map("site_settings")
}

model Fee {
  id String @id @default(cuid()) @db.VarChar(191)
  title String @db.VarChar(255)
  titleTa String @default("") @db.VarChar(255)
  standard String @db.VarChar(10)
  academicYear String @db.VarChar(9)
  category String @db.VarChar(120)
  amount Decimal @db.Decimal(10, 2)
  frequency String @db.VarChar(80)
  installments Int @default(1)
  sourceRef String? @db.VarChar(500)
  sortOrder Int @default(0)
  status ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, academicYear, standard, sortOrder])
  @@map("fees")
}

model Honour {
  id String @id @default(cuid()) @db.VarChar(191)
  name String @db.VarChar(120)
  nameTa String @default("") @db.VarChar(160)
  title String @db.VarChar(255)
  titleTa String @default("") @db.VarChar(255)
  academicYear String @db.VarChar(9)
  standard String @db.VarChar(10)
  category String @db.VarChar(120)
  description String @db.Text
  descriptionTa String @db.Text
  imageId String? @db.VarChar(191)
  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sourceRef String? @db.VarChar(500)
  sortOrder Int @default(0)
  status ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, academicYear, sortOrder])
  @@map("honours")
}

model StaffMember {
  id String @id @default(cuid()) @db.VarChar(191)
  name String @db.VarChar(120)
  nameTa String @default("") @db.VarChar(160)
  designation String @db.VarChar(160)
  designationTa String @default("") @db.VarChar(200)
  department String @db.VarChar(120)
  category String @db.VarChar(120)
  description String @db.Text
  descriptionTa String @db.Text
  imageId String? @db.VarChar(191)
  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sourceRef String? @db.VarChar(500)
  sortOrder Int @default(0)
  status ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, department, sortOrder])
  @@map("staff_members")
}

model Topper {
  id String @id @default(cuid()) @db.VarChar(191)
  name String @db.VarChar(120)
  nameTa String @default("") @db.VarChar(160)
  standard String @db.VarChar(10)
  academicYear String @db.VarChar(9)
  category String @db.VarChar(120)
  marks Decimal? @db.Decimal(8, 2)
  maximumMarks Decimal? @db.Decimal(8, 2)
  percentage Decimal? @db.Decimal(5, 2)
  rank Int?
  imageId String? @db.VarChar(191)
  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sourceRef String? @db.VarChar(500)
  sortOrder Int @default(0)
  status ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, academicYear, standard, sortOrder])
  @@map("toppers")
}
