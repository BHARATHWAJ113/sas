NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://school:School%402026%23Secure@127.0.0.1:3306/st_antonys
DATABASE_SSL=false
# Optional PEM CA file for a remote TLS-enabled MySQL server.
DATABASE_SSL_CA=
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:5173
SESSION_DAYS=1
COOKIE_SECURE=false
TRUST_PROXY=0
UPLOAD_DIR=./uploads
DEMO_MODE=false
# Optional initial administrator. No default password. Use 12+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Explicitly enable labeled demo records. Safe upserts never overwrite edited content.
SEED_DEMO=false

# Gmail SMTP. Use a Google app password from an account with 2-Step Verification.
EMAIL_ENABLED=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_PORT=465
SMTP_FROM_NAME="St. Antony's School"
SMTP_NOTIFY_TO=
# Comma-separated approved office recipients; overrides SMTP_NOTIFY_TO when non-empty.
ADMIN_NOTIFICATION_EMAILS=
EMAIL_MAX_ATTEMPTS=4
EMAIL_POLL_MS=5000

# Change this version when the optional-storage purposes change.
CONSENT_VERSION=2026-11-08
# Optional visitor/enquiry metadata is automatically removed after this period (1–90 days).
VISITOR_RETENTION_DAYS=30
